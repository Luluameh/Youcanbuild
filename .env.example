# Public Stellar testnet settings. Safe to expose in the browser.
# Never put secret keys, seed phrases, or private credentials in any VITE_ variable.
# Vite inlines VITE_ variables into the client bundle.

VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Explorer base (append /tx/<hash> for a transaction link)
VITE_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
